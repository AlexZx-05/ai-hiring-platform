project_name = "ai-hiring-platform"
environment  = "prod"
aws_region   = "ap-south-1"
owner        = "platform-team"

# Must remain false in production.
resume_bucket_force_destroy = false

# Set this from a private tfvars file or TF_VAR_xai_api_key.
xai_api_key = ""
